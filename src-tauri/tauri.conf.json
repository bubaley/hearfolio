{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hearfolio",
  "version": "0.1.0",
  "identifier": "com.bubaley.speechdesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hearfolio",
        "width": 1160,
        "height": 760,
        "minWidth": 850,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/.hearing/input/hearing-*"
          ],
          "requireLiteralLeadingDot": true
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGNDlFNjIwNTIzMUQxOEMKUldTTTBURlNJT1pKejlsNUxadHF0eU81NXdaT0VXcC9QTnB2aUtKcjRNOFZBb1o5OTZzclJJZW0K",
      "endpoints": [
        "https://github.com/bubaley/hearfolio/releases/latest/download/latest.json"
      ]
    }
  }
}
